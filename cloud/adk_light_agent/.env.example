# cloud/adk_light_agent local config. Copy to `.env` (gitignored) and fill in.
# See docs/agent-build/01-cloud-agent.md.

# --- FREE path (default): AI Studio key, no GCP account needed --------------
# Get a key at https://aistudio.google.com/apikey
GOOGLE_GENAI_USE_VERTEXAI=FALSE
GOOGLE_API_KEY=

# Optional: override the Gemini model (defaults to gemini-flash-latest).
# ADK_MODEL=gemini-2.5-flash

# --- Vertex / Agent Engine path (GCP) --------------------------------------
# DO NOT enable without the human checkpoint in the build doc. Leave commented.
# GOOGLE_GENAI_USE_VERTEXAI=TRUE
# GOOGLE_CLOUD_PROJECT=
# GOOGLE_CLOUD_LOCATION=
# (auth via: gcloud auth application-default login)
