{"evaluation":{"model_invocation":"FORBIDDEN","note":"A hard prohibition returns DENY without building features, calling the anomaly model, opening a context round or accepting a technician approval. Model unavailability must not prevent this denial.","order":"BEFORE_GRANTS","override":"NONE"},"prohibitions":[{"actions":["disable_protective_relay"],"agents":["*"],"note":"No agent, user, mode or approval may disable a protective relay.","prohibition_id":"P-RELAY-DISABLE","reason_code":"SAFETY_PROTECTIVE_DEVICE","targets":["*"]},{"actions":["open_switchgear","close_switchgear","set_voltage_setpoint"],"agents":["*"],"prohibition_id":"P-RELAY-SWITCHGEAR","reason_code":"SAFETY_PROTECTIVE_DEVICE","targets":["SPIDERS-RELAY-03"]},{"actions":["curtail_load","set_load_shed_priority"],"agents":["*"],"note":"Clinic, tower, alert facility and fuels operations are never shed or curtailed by an agent under any mode.","parameter_match":{"load_id":{"one_of":["LOAD-ALERT-01","LOAD-CLINIC-01","LOAD-FUELOPS-01","LOAD-TOWER-01"]}},"prohibition_id":"P-PROTECTED-LOAD","reason_code":"PROTECTED_LOAD","targets":["*"]},{"actions":["set_voltage_setpoint"],"agents":["*"],"note":"Placeholder ANSI-shaped service band; requires engineering sign-off before it gates a real feeder.","parameter_match":{"setpoint_v":{"outside":[456.0,504.0],"unit":"volt"}},"prohibition_id":"P-VOLTAGE-ENVELOPE","reason_code":"OUTSIDE_HARD_ENVELOPE","targets":["*"]},{"actions":["dispatch_generator"],"agents":["*"],"parameter_match":{"output_kw":{"outside":[0.0,1250.0],"unit":"kilowatt"}},"prohibition_id":"P-GEN-ENVELOPE","reason_code":"OUTSIDE_HARD_ENVELOPE","targets":["*"]},{"actions":["drop_islanding"],"agents":["*"],"note":"Leaving islanded operation is a human decision; no agent may drop islanding, least of all while disconnected.","prohibition_id":"P-DROP-ISLANDING","reason_code":"MISSION_CONTINUITY","targets":["*"]},{"actions":["close_switchgear","create_work_order","curtail_load","disable_protective_relay","dispatch_generator","drop_islanding","open_switchgear","order_parts","set_load_shed_priority","set_voltage_setpoint","update_asset_record","modify_firewall","allow_outbound"],"agents":["vendor-agent-01"],"prohibition_id":"P-VENDOR-STATE-CHANGE","reason_code":"VENDOR_READ_ONLY","targets":["*"]},{"actions":["close_switchgear","create_work_order","curtail_load","disable_protective_relay","dispatch_generator","drop_islanding","open_switchgear","order_parts","set_load_shed_priority","set_voltage_setpoint","update_asset_record","modify_firewall","allow_outbound"],"agents":["appr-agent-01"],"prohibition_id":"P-APPRENTICE-STATE-CHANGE","reason_code":"TRAINING_ACCOUNT_READ_ONLY","targets":["*"]},{"actions":["order_parts"],"agents":["*"],"conditions":{"mode":"OFFLINE"},"note":"A purchase cannot be reconciled while disconnected, so the offline path never commits one. It is held for reconnection.","prohibition_id":"P-OFFLINE-PURCHASE","reason_code":"NO_OFFLINE_PURCHASE_AUTHORITY","targets":["*"]}],"schema_version":"alice-permissions-prohibitions-v1","site_id":"SEN"}