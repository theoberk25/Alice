{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:alice:schemas:anomaly-result:1.0.0-draft.1",
  "title": "DCAMR anomaly result",
  "description": "Versioned behavioral observations and score. This result never grants execution permission; DCAMR owns authorization. See docs/prds/anomaly-model-prd.md.",
  "$comment": "The runtime additionally enforces the 16 KiB encoded size limit, finite numbers, duplicate-key rejection, sorted unique values and factor IDs, threshold ordering and band consistency, semantic provenance, and binding to the admitted request/snapshot/artifacts. Consumers must enable date-time format validation.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "evaluation_id",
    "previous_evaluation_id",
    "request_id",
    "request_sha256",
    "evaluated_at",
    "status",
    "result",
    "score",
    "score_method",
    "raw_score",
    "source",
    "baseline",
    "model",
    "calibration",
    "input_snapshot",
    "factors",
    "reason_codes",
    "quality",
    "runtime"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0-draft.1"},
    "evaluation_id": {"$ref": "#/$defs/identifier"},
    "previous_evaluation_id": {
      "anyOf": [{"$ref": "#/$defs/identifier"}, {"type": "null"}]
    },
    "request_id": {"$ref": "#/$defs/identifier"},
    "request_sha256": {"$ref": "#/$defs/sha256"},
    "evaluated_at": {
      "anyOf": [{"$ref": "#/$defs/utcTimestamp"}, {"type": "null"}]
    },
    "status": {
      "enum": ["OK", "UNAVAILABLE", "INVALID_INPUT", "TIMEOUT", "ERROR", "SKIPPED"]
    },
    "result": {"enum": ["LOW", "ELEVATED", "HIGH", "UNKNOWN"]},
    "score": {
      "anyOf": [{"$ref": "#/$defs/unitInterval"}, {"type": "null"}]
    },
    "score_method": {"enum": ["normal_tail_rank_v1", null]},
    "raw_score": {
      "anyOf": [{"$ref": "#/$defs/rawScore"}, {"type": "null"}]
    },
    "source": {
      "description": "Stable provenance label for the accepted baseline; never a fetch instruction.",
      "anyOf": [{"$ref": "#/$defs/reference"}, {"type": "null"}]
    },
    "baseline": {
      "anyOf": [{"$ref": "#/$defs/baseline"}, {"type": "null"}]
    },
    "model": {
      "anyOf": [{"$ref": "#/$defs/model"}, {"type": "null"}]
    },
    "calibration": {
      "anyOf": [{"$ref": "#/$defs/calibration"}, {"type": "null"}]
    },
    "input_snapshot": {"$ref": "#/$defs/inputSnapshot"},
    "factors": {
      "description": "Sorted by unique id. Independent baseline comparisons do not add up to the model score or establish causation.",
      "type": "array",
      "maxItems": 16,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/factor"}
    },
    "reason_codes": {
      "description": "Sorted, unique anomaly reasons. Adapter rejection reasons are deliberately excluded.",
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/reasonCode"}
    },
    "quality": {"$ref": "#/$defs/quality"},
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["duration_ms", "execution_mode"],
      "properties": {
        "duration_ms": {"type": "number", "minimum": 0},
        "execution_mode": {"enum": ["LIVE", "FIXTURE"]}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "OK"}}, "required": ["status"]},
      "then": {
        "properties": {
          "result": {"enum": ["LOW", "ELEVATED", "HIGH"]},
          "score": {"$ref": "#/$defs/unitInterval"},
          "score_method": {"const": "normal_tail_rank_v1"},
          "raw_score": {"$ref": "#/$defs/rawScore"},
          "source": {"$ref": "#/$defs/reference"},
          "baseline": {"$ref": "#/$defs/baseline"},
          "model": {"$ref": "#/$defs/model"},
          "calibration": {"$ref": "#/$defs/calibration"},
          "evaluated_at": {"$ref": "#/$defs/utcTimestamp"},
          "input_snapshot": {
            "properties": {"observed_at": {"$ref": "#/$defs/utcTimestamp"}}
          }
        }
      },
      "else": {
        "properties": {
          "result": {"const": "UNKNOWN"},
          "score": {"type": "null"},
          "score_method": {"type": "null"},
          "raw_score": {"type": "null"}
        }
      }
    },
    {
      "if": {"properties": {"status": {"const": "SKIPPED"}}, "required": ["status"]},
      "then": {
        "properties": {
          "model": {"type": "null"},
          "reason_codes": {
            "contains": {"const": "POLICY_DENY_SHORT_CIRCUIT"},
            "items": {"enum": ["POLICY_DENY_SHORT_CIRCUIT", "CLOCK_UNTRUSTED"]}
          }
        }
      }
    },
    {
      "if": {
        "properties": {"evaluated_at": {"type": "null"}},
        "required": ["evaluated_at"]
      },
      "then": {
        "properties": {
          "reason_codes": {"contains": {"const": "CLOCK_UNTRUSTED"}},
          "quality": {
            "properties": {
              "missing_fields": {"contains": {"const": "evaluated_at"}}
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "input_snapshot": {
            "properties": {"observed_at": {"type": "null"}},
            "required": ["observed_at"]
          }
        },
        "required": ["input_snapshot"]
      },
      "then": {
        "properties": {
          "reason_codes": {"contains": {"const": "CLOCK_UNTRUSTED"}},
          "quality": {
            "properties": {
              "missing_fields": {"contains": {"const": "input_snapshot.observed_at"}}
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "identifier": {"type": "string", "minLength": 1, "maxLength": 128},
    "reference": {"type": "string", "minLength": 1, "maxLength": 256},
    "sha256": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64,
      "pattern": "^[0-9a-f]{64}$"
    },
    "utcTimestamp": {
      "type": "string",
      "minLength": 20,
      "maxLength": 128,
      "format": "date-time",
      "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]+)?(?:Z|\\+00:00)$",
      "description": "Trusted UTC in RFC 3339 form, using Z or +00:00. The current contract does not accept leap-second timestamps. Null time is represented at the containing field with CLOCK_UNTRUSTED."
    },
    "unitInterval": {"type": "number", "minimum": 0, "maximum": 1},
    "rawScore": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "value"],
      "properties": {
        "method": {"const": "sklearn_isolation_forest.score_samples"},
        "value": {"type": "number"}
      }
    },
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["package_id", "version", "sha256"],
      "properties": {
        "package_id": {"$ref": "#/$defs/identifier"},
        "version": {"$ref": "#/$defs/identifier"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "sha256", "feature_schema_version"],
      "properties": {
        "name": {"$ref": "#/$defs/identifier"},
        "version": {"$ref": "#/$defs/identifier"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "feature_schema_version": {"$ref": "#/$defs/identifier"}
      }
    },
    "calibration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "sha256", "sample_count", "threshold_profile", "elevated_min", "high_min"],
      "properties": {
        "version": {"$ref": "#/$defs/identifier"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "sample_count": {"type": "integer", "minimum": 1},
        "threshold_profile": {"$ref": "#/$defs/identifier"},
        "elevated_min": {"type": "number", "minimum": 0, "exclusiveMaximum": 1},
        "high_min": {"type": "number", "exclusiveMinimum": 0, "maximum": 1}
      }
    },
    "inputSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "sha256", "observed_at", "history_window_seconds", "context_attempt"],
      "properties": {
        "id": {"$ref": "#/$defs/identifier"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "observed_at": {
          "anyOf": [{"$ref": "#/$defs/utcTimestamp"}, {"type": "null"}]
        },
        "history_window_seconds": {"type": "integer", "minimum": 0},
        "context_attempt": {"type": "integer", "minimum": 0}
      }
    },
    "displayScalar": {
      "anyOf": [
        {"type": "null"},
        {"type": "boolean"},
        {"type": "number"},
        {"type": "string", "maxLength": 256}
      ]
    },
    "factor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "state", "observed", "expected", "unit", "baseline_ref", "observation_ref"],
      "properties": {
        "id": {"$ref": "#/$defs/identifier"},
        "state": {"enum": ["EXPECTED", "UNUSUAL", "UNKNOWN", "NOT_APPLICABLE"]},
        "observed": {"$ref": "#/$defs/displayScalar"},
        "expected": {"$ref": "#/$defs/displayScalar"},
        "unit": {"$ref": "#/$defs/identifier"},
        "baseline_ref": {
          "anyOf": [{"$ref": "#/$defs/reference"}, {"type": "null"}]
        },
        "observation_ref": {
          "anyOf": [{"$ref": "#/$defs/reference"}, {"type": "null"}]
        }
      },
      "allOf": [
        {
          "if": {"properties": {"state": {"const": "UNKNOWN"}}, "required": ["state"]},
          "then": {
            "anyOf": [
              {"properties": {"observed": {"type": "null"}}},
              {"properties": {"expected": {"type": "null"}}}
            ],
            "$comment": "The runtime also requires an explanatory reason and a quality path for this factor."
          }
        }
      ]
    },
    "reasonCode": {
      "enum": [
        "WITHIN_BASELINE",
        "AGENT_UNSEEN",
        "TARGET_UNSEEN",
        "DESTINATION_UNSEEN",
        "SEQUENCE_UNUSUAL",
        "REQUEST_RATE_UNUSUAL",
        "OUTSIDE_OPERATING_WINDOW",
        "HIGH_MODEL_ANOMALY",
        "ELEVATED_MODEL_ANOMALY",
        "BASELINE_MISSING",
        "BASELINE_EXPIRED",
        "BASELINE_UNTRUSTED",
        "MODEL_MISSING",
        "MODEL_BASELINE_MISMATCH",
        "CALIBRATION_INVALID",
        "FEATURE_SCHEMA_MISMATCH",
        "REQUIRED_INPUT_MISSING",
        "INPUT_STALE",
        "INPUT_NONFINITE",
        "INPUT_UNSUPPORTED",
        "CLOCK_UNTRUSTED",
        "HISTORY_INCOMPLETE",
        "HISTORY_CAPACITY_EXCEEDED",
        "POLICY_DENY_SHORT_CIRCUIT",
        "INFERENCE_TIMEOUT",
        "INFERENCE_ERROR",
        "INPUT_LIMIT_EXCEEDED",
        "CAPACITY_EXCEEDED"
      ]
    },
    "qualityPaths": {
      "description": "Sorted unique field paths into the admitted input/result context.",
      "type": "array",
      "maxItems": 16,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/reference"}
    },
    "quality": {
      "type": "object",
      "additionalProperties": false,
      "required": ["missing_fields", "stale_fields", "unsupported_fields"],
      "properties": {
        "missing_fields": {"$ref": "#/$defs/qualityPaths"},
        "stale_fields": {"$ref": "#/$defs/qualityPaths"},
        "unsupported_fields": {"$ref": "#/$defs/qualityPaths"}
      }
    }
  }
}
