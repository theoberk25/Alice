{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "alice-action-request-v1",
  "title": "First-light terminal action request (strict, test-scoped)",
  "description": "Exact contract for first-light light and fan integration tests. Each action is bound to its agreed target and parameter shape; widening remains a coordinated contract change per AGENTS.md.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "request_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*(?![\\s\\S])"
    },
    "agent_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*(?![\\s\\S])"
    },
    "action": {
      "enum": ["set_light_state", "set_fan_speed"]
    },
    "target": {
      "enum": [
        "ESP-LIGHT-01",
        "ESP-LIGHT-02",
        "ESP-LIGHT-03",
        "ESP-LIGHT-04",
        "ESP-LIGHT-05",
        "ESP-LIGHT-06",
        "ESP-LIGHT-07",
        "ESP-LIGHT-08",
        "SERVER-ROOM-FANS"
      ]
    },
    "parameters": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "state": {
          "enum": [
            "on",
            "off"
          ]
        },
        "value": {"type": "integer", "minimum": 0, "maximum": 100}
      }
    },
    "issued_at": {
      "type": "string",
      "maxLength": 40,
      "format": "date-time",
      "pattern": "Z(?![\\s\\S])"
    }
  },
  "required": [
    "schema_version",
    "request_id",
    "agent_id",
    "action",
    "target",
    "parameters",
    "issued_at"
  ],
  "allOf": [
    {
      "if": {"properties": {"action": {"const": "set_light_state"}}},
      "then": {
        "properties": {
          "target": {"enum": ["ESP-LIGHT-01", "ESP-LIGHT-02", "ESP-LIGHT-03", "ESP-LIGHT-04", "ESP-LIGHT-05", "ESP-LIGHT-06", "ESP-LIGHT-07", "ESP-LIGHT-08"]},
          "parameters": {"required": ["state"], "not": {"required": ["value"]}}
        }
      }
    },
    {
      "if": {"properties": {"action": {"const": "set_fan_speed"}}},
      "then": {
        "properties": {
          "target": {"const": "SERVER-ROOM-FANS"},
          "parameters": {"required": ["value"], "not": {"required": ["state"]}}
        }
      }
    }
  ]
}
