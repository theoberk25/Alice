[Unit]
Description=ALICE governed thermal demo with USB audit and Wazuh delivery
Wants=network-online.target
After=network-online.target
RequiresMountsFor=/mnt/alice-usb
Conflicts=alice-runtime.service

[Service]
Type=simple
User=pi
Group=pi
SupplementaryGroups=dialout
WorkingDirectory=/home/pi/Alice
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=/etc/alice/thermal-demo.env
ExecStart=/home/pi/Alice/.venv/bin/python -m services.thermal_demo.server --port 8080 --release /mnt/alice-usb/thermal-release --trust-key /home/pi/first-light/thermal-demo/manifest-public.hex --data-dir /mnt/alice-usb/pi-data --usb-root /mnt/alice-usb --ledger-key-file /home/pi/first-light/pi-data/ledger_key.seed --wazuh-sync-config /home/pi/first-light/wazuh-sync/config.json --agent-keys /home/pi/first-light/thermal-demo/agent-keys.json --fan-model-file /home/pi/first-light/models/fan-model.json --console-trust-file /home/pi/first-light/trust/console-trust.json --esp-serial /dev/serial/by-id/usb-Espressif_USB_JTAG_serial_debug_unit_A4:CB:8F:D2:6E:EC-if00 --energy-time-scale 60
Restart=on-failure
RestartSec=5
KillSignal=SIGINT
TimeoutStopSec=35
UMask=0077
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
