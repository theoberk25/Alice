[Unit]
Description=ALICE machine-metrics poller (local Goose agent) — 0.1s pull of fan/temp/power via MCP
Wants=network-online.target
After=network-online.target light-mcp.service
Requires=light-mcp.service

[Service]
Type=simple
# Adjust User/Group/WorkingDirectory for the target host.
WorkingDirectory=/home/pi/Alice
Environment=PYTHONUNBUFFERED=1
Environment=LIGHT_MCP_URL=http://127.0.0.1:8795/mcp
Environment=METRICS_POLL_INTERVAL=0.1
# Private file contains only this agent’s LIGHT_MCP_TOKEN.
EnvironmentFile=/etc/alice/metrics-local.env
ExecStart=/home/pi/Alice/.venv/bin/python -m services.light_mcp.poller --agent local
Restart=on-failure
RestartSec=2
KillSignal=SIGINT
TimeoutStopSec=10
UMask=0077
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
