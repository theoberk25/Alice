[Unit]
Description=ALICE governed machine-metrics MCP server
Wants=network-online.target
After=network-online.target
RequiresMountsFor=/mnt/alice-usb

[Service]
Type=simple
# Adjust User/Group/WorkingDirectory for the target host.
WorkingDirectory=/home/pi/Alice
Environment=PYTHONUNBUFFERED=1
Environment=LIGHT_MCP_HOST=127.0.0.1
Environment=LIGHT_MCP_PORT=8795
# The Pi state file the MCP reads. Authorized writes are owned by alice-runtime.
Environment=MACHINE_STATE_FILE=/mnt/alice-usb/machine-state.json
# Set these in a private systemd credential/drop-in; never commit the seed.
Environment=ALICE_RUNTIME_URL=http://192.168.50.20:8080
ExecStart=/home/pi/Alice/.venv/bin/python -m services.light_mcp.server
Restart=on-failure
RestartSec=5
KillSignal=SIGINT
TimeoutStopSec=15
UMask=0077
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
