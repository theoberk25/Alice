[Unit]
Description=ALICE governed machine-metrics MCP server (Streamable HTTP)
Wants=network-online.target
Requires=alice-thermal-demo.service
After=network-online.target alice-thermal-demo.service

[Service]
Type=simple
User=pi
Group=pi
WorkingDirectory=/home/pi/Alice
Environment=PYTHONUNBUFFERED=1
Environment=LIGHT_MCP_HOST=127.0.0.1
Environment=LIGHT_MCP_PORT=8790
# One authoritative thermal plant; MCP never owns the fan state file or serial port.
Environment=MACHINE_BACKEND=thermal
Environment=THERMAL_DEMO_URL=http://127.0.0.1:8795
# Private file with THERMAL_AGENT_TOKENS (same mapping as the demo backend).
EnvironmentFile=/etc/alice/metrics-mcp.env
ExecStart=/home/pi/Alice/.venv/bin/python -m services.light_mcp.server
Restart=on-failure
RestartSec=5
KillSignal=SIGINT
TimeoutStopSec=15
UMask=0077
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
