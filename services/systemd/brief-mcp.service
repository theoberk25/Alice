[Unit]
Description=ALICE Decision-Brief MCP server (Streamable HTTP, mock source)
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
# Adjust User/Group/WorkingDirectory for the target host.
WorkingDirectory=/home/pi/Alice
Environment=PYTHONUNBUFFERED=1
Environment=BRIEF_MCP_HOST=127.0.0.1
Environment=BRIEF_MCP_PORT=8793
Environment=BRIEF_SOURCE=mock
ExecStart=/home/pi/Alice/.venv/bin/python -m services.brief_mcp.server
Restart=on-failure
RestartSec=5
KillSignal=SIGINT
TimeoutStopSec=15
UMask=0077
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
