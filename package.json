{
  "name": "alice-technician-console",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/desktop",
    "packages/contracts",
    "packages/domain",
    "packages/ui"
  ],
  "scripts": {
    "dev": "vite --config apps/desktop/vite.config.ts",
    "demo": "node scripts/console/desktop.mjs dev",
    "desktop": "node scripts/console/desktop.mjs",
    "build": "npm run typecheck && vite build --config apps/desktop/vite.config.ts",
    "build:app": "node scripts/console/desktop.mjs build --bundles app",
    "launch:app": "node scripts/console/desktop.mjs launch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint apps/desktop packages/contracts packages/domain packages/ui fixtures tests/console scripts/console scripts/biometrics *.ts *.js",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:rust": "node scripts/console/rust.mjs test",
    "test:python": "services/biometrics/.venv/bin/python -m pytest services/biometrics/tests -q",
    "check": "npm run typecheck && npm run lint && npm test && npm run test:scripts && npm run build",
    "biometrics": "node scripts/biometrics/biometrics.mjs",
    "format": "prettier --write apps/desktop/src apps/desktop/*.ts packages/contracts packages/domain packages/ui fixtures/scenarios tests/console scripts/console scripts/biometrics/*.mjs *.json *.ts *.js",
    "contracts:generate": "node scripts/console/generate-contracts.mjs",
    "test:scripts": "node --test scripts/console/tests/*.test.mjs",
    "demo:live": "node scripts/console/live-demo.mjs",
    "test:e2e:runtime": "playwright test --config playwright.runtime.config.ts",
    "demo:hold": ".venv/bin/python -m lab.first_light.send_native_hold"
  },
  "dependencies": {
    "@fontsource/barlow-condensed": "^5.2.6",
    "@fontsource/ibm-plex-mono": "^5.2.6",
    "@fontsource/ibm-plex-sans": "^5.2.6",
    "@tauri-apps/api": "^2.8.0",
    "lucide-react": "^0.468.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "^4.1.5",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.34.0",
    "@playwright/test": "^1.55.0",
    "@tauri-apps/cli": "^2.8.0",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.18.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^9.34.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.9.6",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.41.0",
    "vite": "^6.4.0",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=22"
  }
}
