ALICE_ENV=development
ALICE_TRANSPORT_MODE=mock
ALICE_BIOMETRIC_MODE=mock
ALICE_ADMIN_USERNAME=
ALICE_ADMIN_PASSWORD=
OLLAMA_BASE_URL=http://127.0.0.1:11434
ALICE_LLM_MODEL=
ALICE_BIOMETRIC_SERVICE_URL=http://127.0.0.1:8765
ALICE_BIOMETRIC_TOKEN=
ALICE_DATABASE_PATH=
ALICE_BIOMETRIC_DATA_DIR=
ALICE_INSIGHTFACE_ROOT=
ALICE_FACE_THRESHOLD=0.45
# Browser preview only. Packaged native mode reads ALICE_TRANSPORT_MODE in Rust.
VITE_ALICE_PREVIEW_MODE=mock
# Opt-in popup rehearsal build: mock HOLD waits for an explicit context click;
# exposes scenario/reset controls. Has no effect on remote runtime review.
VITE_ALICE_MANUAL_CONTEXT_DEMO=false
# Live read-only bridge. Keep token private; never use a VITE_ token variable.
# For live browser use VITE_ALICE_PREVIEW_MODE=remote.
# For native use ALICE_TRANSPORT_MODE=remote and ALICE_BIOMETRIC_MODE=arcface.
ALICE_FEED_URL=http://127.0.0.1:8787
ALICE_FEED_TOKEN=
# Native signed HOLD review only; create keys explicitly outside this checkout.
# This does not install Pi trust or grant execution ownership.
ALICE_CONSOLE_ID=
ALICE_REVIEW_KEY_FILE=
# Interim authenticated, read-only LAN web dashboard. Leave disabled for normal
# loopback preview and replace ALICE_WEB_PUBLIC_HOST with the host Mac's wired IP.
ALICE_WEB_LISTEN=loopback
VITE_ALICE_WEB_LOGIN=disabled
ALICE_WEB_PUBLIC_HOST=127.0.0.1:1420
ALICE_WEB_USERNAME=
ALICE_WEB_PASSWORD=

# Light-Control MCP server (services/light_mcp/). See docs/agent-build/03-light-mcp.md.
# Canonical URL both agents connect to: http://127.0.0.1:8790/mcp (Streamable HTTP).
LIGHT_MCP_HOST=127.0.0.1
LIGHT_MCP_PORT=8790
LIGHT_DRIVER=mock            # mock | esp | alice
                             #   mock  = in-memory (default), no hardware, no ALICE
                             #   esp   = DIRECT serial to the XIAO (on-Pi only; BYPASSES the ALICE gate — bench use)
                             #   alice = GATE-FAITHFUL: signed set_light_state requests through the Pi runtime (recommended)
LIGHT_SERIAL_PORT=           # esp only; XIAO is USB-attached to the Pi, e.g. /dev/serial/by-id/usb-Espressif_USB_JTAG_...-if00
LIGHT_SERIAL_BAUD=115200
LIGHT_MACHINES_CONFIG=services/light_mcp/machines.yaml
# Governed driver (LIGHT_DRIVER=alice) — the MCP signs requests and lets ALICE decide/enforce/audit:
ALICE_RUNTIME_URL=http://127.0.0.1:18080   # Pi runtime /request via SSH tunnel (or http://192.168.50.20:8080 on-LAN)
ALICE_AGENT_ID=                            # provisioned agent id, e.g. elec-agent-01 (key_id becomes <agent>-k1)
ALICE_AGENT_KEY_FILE=                      # path to the agent's PRIVATE Ed25519 seed (hex). Keep secret; never commit.

# Enterprise-first ingress for the ADK cloud agent (cloud/enterprise_ingress_client.py).
# When set, the cloud agent gains a `submit_governed_request` tool that signs a
# set_light_state, POSTs it to <URL>/request (GET <URL>/health preflight), the
# ingress records an enterprise receipt in Wazuh, then forwards to the Pi.
# UNSET = agent keeps only its MCP tools (default). Reuses ALICE_AGENT_ID/KEY_FILE
# above for signing. See docs/integration/cloud-agent-enterprise-ingress.md.
ALICE_ENTERPRISE_INGRESS_URL=              # base URL, e.g. http://192.168.50.50:8790  (real ingress lives on the enterprise Mac)

# Machine-metrics mode (services/light_mcp/, same URL http://127.0.0.1:8790/mcp).
# Agents keep get_metrics / set_fan_speed(value); thermal mode delegates to ALICE.
# Legacy LIGHT_DRIVER/LIGHT_SERIAL_*/LIGHT_MACHINES_CONFIG are unused by this server.
MACHINE_BACKEND=thermal       # thermal (governed default) | file (isolated test only)
THERMAL_DEMO_URL=http://127.0.0.1:8795
THERMAL_AGENT_TOKENS=         # private JSON agent-id -> bearer token; same map as thermal backend
LIGHT_MCP_TOKEN=             # each agent/poller sends its own token from that map
# The following file and seeds are used ONLY when MACHINE_BACKEND=file.
MACHINE_STATE_FILE=services/light_mcp/machine_state.json   # on the Pi: absolute path to the state file
FAN_SPEED_MIN=0
FAN_SPEED_MAX=100
SEED_FAN_SPEED=50            # seeds used only when the state file is first created
SEED_SERVER_TEMPERATURE=45
SEED_POWER_CONSUMPTION=300
# Per-agent 0.1s pollers (services/light_mcp/poller.py; one per agent):
LIGHT_MCP_URL=http://127.0.0.1:8790/mcp
METRICS_POLL_INTERVAL=0.1

# Decision-Brief MCP server (services/brief_mcp/). See docs/agent-build/04-brief-mcp.md.
# Formats ALICE's held decisions into technician-facing briefs on the review dashboard.
# Canonical URL the brief agent connects to: http://127.0.0.1:8793/mcp (Streamable HTTP).
BRIEF_MCP_HOST=127.0.0.1
BRIEF_MCP_PORT=8793
BRIEF_SOURCE=mock            # mock | alice
                             #   mock  = fixture holds + in-memory brief store (default), no ALICE/dashboard
                             #   alice = read authoritative held decisions from the Pi runtime/ledger and publish
                             #           briefs to the dashboard (stub until the console wire schema is agreed)
BRIEF_HOLDS_CONFIG=services/brief_mcp/holds.yaml
BRIEF_DASHBOARD_URL=         # alice source only; where formatted briefs are published to the dashboard
# The alice source also reads ALICE_RUNTIME_URL (shared with the Light MCP block above).
# Live face recognition uses the native camera and the local service.
# Install requirements-live.txt separately and run scripts/biometrics/setup_live_models.py.
# Existing V1 enrollments and private stores must be preserved.
