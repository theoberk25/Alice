{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "event_type": {
      "type": "string",
      "const": "alice.context_request"
    },
    "command_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "decision_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "request_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "agent_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "challenge_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "requested_fields": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "mission_justification",
          "expected_effect",
          "evidence_references",
          "alternatives_considered"
        ]
      }
    },
    "question": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    }
  },
  "required": [
    "schema_version",
    "event_type",
    "command_id",
    "timestamp",
    "decision_id",
    "request_id",
    "agent_id",
    "challenge_id",
    "requested_fields",
    "question"
  ],
  "additionalProperties": false
}
