{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ALICE",
  "version": "0.1.0",
  "identifier": "org.alice.technician-console",
  "build": {
    "beforeDevCommand": "npm run dev --prefix ../..",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build --prefix ../..",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{"label":"main","title":"ALICE — Technician Console","width":1512,"height":1040,"minWidth":760,"minHeight":640,"backgroundColor":"#080e16"}],
    "security": {"csp":"default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; media-src 'self' blob:; connect-src ipc: http://ipc.localhost"}
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "resources": ["third-party-notices.md"],
    "icon": ["icons/32x32.png","icons/128x128.png","icons/128x128@2x.png","icons/icon.icns"],
    "macOS": {"minimumSystemVersion":"12.0","infoPlist":"Info.plist","entitlements":"Entitlements.plist"}
  }
}
